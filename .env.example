# Copy this file to ".env" for local settings (".env" is git-ignored). Everything is optional locally:
# with no settings at all, enquiry emails are printed to the console instead of being sent.

# --- Server ---------------------------------------------------------------------------------
# PORT=3001

# --- Email (Amazon SES SMTP, or any SMTP server) --------------------------------------------
# Leave SMTP_HOST empty to print emails to the console (development).
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# TO_EMAIL=office@intelyx.co.in
# FROM_EMAIL=no-reply@intelyx.co.in
# FROM_NAME=Intelyx Website
# SEND_ACK=false          # "true" also emails a thank-you to the visitor (needs SES production access)

# --- Production only (set by the deploy workflow; see DEPLOY.md) ------------------------------
# FORCE_HTTPS=true        # redirect http -> https
# APEX_HOST=intelyx.co.in # redirect the bare domain to CANONICAL_HOST
# CANONICAL_HOST=www.intelyx.co.in
# RATE_LIMIT_MAX=5        # enquiries per visitor (IP) per minute
